{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "devpulse",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/docs", "/openapi.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devpulse",
      // Replaced with the real id after `wrangler d1 create devpulse`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
