{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "devpulse",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/docs", "/openapi.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devpulse",
      "database_id": "672ca985-5699-4480-9a1e-8e5395969551"
    }
  ],
  "routes": [{ "pattern": "devpulse.eshita.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
